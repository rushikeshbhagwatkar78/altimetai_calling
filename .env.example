# ============================================================
# LIVEKIT
# ============================================================
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=YOUR_OUTBOUND_TRUNK_ID
AGENT_NAME=ai-calling-agent

# ============================================================
# GOOGLE GEMINI (3.1 Live Native Audio & Embeddings)
# ============================================================
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
EMBEDDING_MODEL=models/gemini-embedding-2

# ============================================================
# SECURITY & AUTHENTICATION
# ============================================================
# Secret key used for signing authentication session tokens
AUTH_SECRET_KEY=nagpur-estates-super-secret-key-change-in-production-2025
ADMIN_EMAIL=admin@nagpurestates.com
ADMIN_PASSWORD=admin123

# ============================================================
# DATABASE & CRM
# ============================================================
DATABASE_URL=sqlite:///nagpur_estates.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/nagpur_estates_crm

COMPANY_NAME=Nagpur Estates
AGENT_DISPLAY_NAME=Priya

API_HOST=0.0.0.0
API_PORT=8000

# Set to true to automatically launch the LiveKit Voice Agent worker in the same container/process
RUN_AGENT_IN_BACKGROUND=true

DEV_MODE=false
BENCHMARK_MODE=true
MAX_CALL_DURATION_SECONDS=600
CUSTOMER_SILENCE_TIMEOUT_SECONDS=7

